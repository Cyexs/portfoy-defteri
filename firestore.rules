rules_version = '2';
// Portföy Defteri security rules.
// Paste into Firebase Console → Firestore Database → Rules → Publish whenever this file changes.
service cloud.firestore {
  match /databases/{database}/documents {
    // Every person reads and writes only their own notebook.
    match /data/users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Roles ('sahip' reads feedback, later 'pro' from Google Play): a person can see their own role, nobody can grant one from the app.
    // Roles are written only from the Firebase Console (or later the payment system).
    match /roller/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // Feedback: anyone may send a short message; the owner reads and replies, the sender reads their own.
    match /geribildirim/{id} {
      allow create: if request.resource.data.keys().hasOnly(['metin', 'tur', 'zaman', 'uid', 'eposta'])
        && request.resource.data.metin is string
        && request.resource.data.metin.size() > 0 && request.resource.data.metin.size() <= 2000
        && request.resource.data.tur is string && request.resource.data.tur.size() <= 20
        && (request.resource.data.uid == '' || (request.auth != null && request.resource.data.uid == request.auth.uid))
        && (request.resource.data.eposta == '' || (request.auth != null && request.resource.data.eposta == request.auth.token.email));
      // The owner reads everything; a signed-in sender reads their own messages (and the replies).
      allow read: if request.auth != null && (
        resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/roller/$(request.auth.uid)).data.rol == 'sahip');
      // Only the owner may add a reply, and only the reply fields change.
      allow update: if request.auth != null
        && get(/databases/$(database)/documents/roller/$(request.auth.uid)).data.rol == 'sahip'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['yanit', 'yanitZaman'])
        && request.resource.data.yanit is string && request.resource.data.yanit.size() <= 2000;
      allow delete: if false;
    }
  }
}
